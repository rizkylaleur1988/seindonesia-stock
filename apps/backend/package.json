{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend service",
  "license": "ISC",
  "author": "rizkylaleur1988@gmail.com",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint \"{src,tests}/**/*.ts\" --fix",
    "prettier": "prettier \"{src,tests}/**/*.ts\" --write --ignore-unknown",
    "test": "jest --detectOpenHandles --verbose --runInBand --silent=false",
    "test:coverage": "jest --coverage",
    "test:clear": "jest --clearCache",
    "dev": "tsc --noEmit --watch & tsx watch src/index.ts"
  },
  "lint-staged": {
    "**/*": [
      "npm run lint",
      "npm run prettier"
    ],
    "**/*.test.ts": [
      "npm run test:clear",
      "npm run test",
      "npm run test:coverage"
    ]
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^1.0.0-rc.5",
    "express": "^5.3.0",
    "express-http-context": "^2.0.1",
    "express-rate-limit": "^8.7.5",
    "express-validator": "^7.3.2",
    "express-winston": "^4.2.0",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "request-ip": "^3.3.0",
    "tsyringe": "^4.10.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/request-ip": "^0.0.41",
    "drizzle-kit": "^1.0.0-rc.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.1",
    "prettier": "3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "argon2@0.45.2": true
  }
}
